# Copy to .env and fill in. Never commit .env.

# --- Production (Railway + R2) ---
DATABASE_URL=postgresql+psycopg://amgold:amgold@localhost:5433/amgold
JWT_SECRET=change-me-long-random
ADMIN_API_KEY=change-me-admin-key
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=amgold-media
R2_BACKUP_BUCKET=amgold-backups
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
MODEL_NAME=facebook/dinov2-small
TOP_K=5
AMBIGUITY_MARGIN=0.05
MIN_CONFIDENCE=0.50
MAX_DEVICES=3
SAVE_SCAN_IMAGES=ambiguous_only
LOG_LEVEL=INFO
STORAGE_LOCAL_DIR=data/storage
LOAD_EMBEDDER=false

# --- Prototype local scan (optional while migrating) ---
API_KEY=change-me-to-a-long-random-secret
DATA_DIR=data
